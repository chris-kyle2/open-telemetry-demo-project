# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Except example files
!example.tfvars
!terraform.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Lock files
.terraform.lock.hcl

# Ignore Mac/OSX system files
.DS_Store

# Ignore VS Code settings
.vscode/

# Ignore local environment files
.env

# Ignore any local key files or certificates
*.pem
*.key
*.pub

# Ignore plan output files
tfplan
*.tfplan

# Ignore CLI local state
.terraform.tfstate.lock.info

# Ignore any local backup files
*.bak
*.backup
*~